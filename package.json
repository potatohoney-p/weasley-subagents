{
  "name": "weasley-subagents",
  "version": "0.39.0",
  "description": "Open-source Pi orchestration for focused subagents, parallel reviews, workflows, and background runs",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Weasley Open Source",
    "email": "potatohoney.p@gmail.com",
    "url": "https://github.com/potatohoney-p"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potatohoney-p/weasley-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/potatohoney-p/weasley-subagents/issues"
  },
  "homepage": "https://github.com/potatohoney-p/weasley-subagents#readme",
  "exports": {
    ".": "./index.ts",
    "./background-work": "./src/api/background-work.ts",
    "./delegation": "./src/api/delegation.ts",
    "./capability-ceiling": "./src/api/capability-ceiling.ts",
    "./preflight": "./src/api/preflight.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "ai",
    "agents",
    "orchestration",
    "weasley"
  ],
  "bin": {
    "weasley-subagents": "install.mjs"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "*.mjs",
    "agents/",
    "skills/**/*",
    "prompts/**/*",
    "assets/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test-force-exit --test-concurrency=2 --test test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test-force-exit --test-concurrency=2 --import ./test/support/register-loader.mjs --test test/integration/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test-force-exit --test-concurrency=1 --import ./test/support/register-loader.mjs --test test/e2e/*.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --json"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "2.7.0",
    "typebox": "1.1.38",
    "yaml": "2.8.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "protobufjs": "7.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.81.0",
    "@earendil-works/pi-ai": "0.81.0",
    "@earendil-works/pi-coding-agent": "0.81.0",
    "@earendil-works/pi-tui": "0.81.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
